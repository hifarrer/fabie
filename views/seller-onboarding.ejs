<section class="grid" style="gap: 18px">
  <div class="card" style="border: 2px solid var(--brand2);">
    <div class="pad">
      <div class="kicker" style="border-color: var(--brand2); color: var(--brand2);">Welcome to FABIE!</div>
      <h2 class="h2" style="margin-top: 10px">Get Started with Your First Listing</h2>
      <p class="p">Let's create your first product listing using our AI-powered tools. This will help you understand how FABIE works.</p>
    </div>
  </div>

  <!-- Instructions Card -->
  <div class="card">
    <div class="pad">
      <div class="h3" style="margin-bottom: 18px;">📋 How It Works</div>
      
      <div style="display: grid; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: start;">
          <div style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">1</div>
          <div>
            <div style="font-weight: 600; margin-bottom: 4px;">Create Your First Listing</div>
            <p class="p" style="font-size: 0.875rem;">Go to your seller dashboard and create a new listing. You can use the "AI Powered Listing" feature to import products from websites or documents, or create listings manually.</p>
          </div>
        </div>

        <div style="display: flex; gap: 12px; align-items: start;">
          <div style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">2</div>
          <div>
            <div style="font-weight: 600; margin-bottom: 4px;">Fill in Product Details</div>
            <p class="p" style="font-size: 0.875rem;">Add product information including name, description, specifications, pricing, and images. Each listing includes a Digital Product Passport (DPP) with all the product information.</p>
          </div>
        </div>

        <div style="display: flex; gap: 12px; align-items: start;">
          <div style="flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">3</div>
          <div>
            <div style="font-weight: 600; margin-bottom: 4px;">Publish Your Listing</div>
            <p class="p" style="font-size: 0.875rem;">Once your listing is complete, publish it to make it visible in the marketplace. Buyers can then discover and inquire about your products.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tips Card -->
  <div class="card">
    <div class="pad">
      <div class="h3" style="margin-bottom: 18px;">💡 Tips for Best Results</div>
      <ul style="margin: 0; padding-left: 20px; color: var(--muted);">
        <li style="margin-bottom: 8px;">Use the "AI Powered Listing" feature to quickly import products from websites or documents</li>
        <li style="margin-bottom: 8px;">Include clear product names, descriptions, and specifications in your listings</li>
        <li style="margin-bottom: 8px;">Add high-quality product images to make your listings more attractive</li>
        <li>You can always edit your listings later from the seller dashboard</li>
      </ul>
    </div>
  </div>

  <!-- Skip/Complete Section -->
  <div class="card">
    <div class="pad">
      <div class="row" style="justify-content: space-between; align-items: center;">
        <div>
          <div class="h3" style="margin-bottom: 4px;">Ready to Continue?</div>
          <p class="p" style="font-size: 0.875rem;">Ready to start? You can explore the dashboard and create your first listing, or complete onboarding now.</p>
        </div>
        <div class="row" style="gap: 12px;">
          <button type="button" class="btn" onclick="skipOnboarding()">Skip for Now</button>
          <button type="button" class="btn primary" onclick="completeOnboarding()" id="complete-btn">
            Complete Onboarding
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
async function completeOnboarding() {
  try {
    const response = await fetch('/seller/onboarding/complete', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      throw new Error('Failed to complete onboarding');
    }

    // Redirect to dashboard
    window.location.href = '/seller/dashboard';
    
  } catch (error) {
    console.error('Error completing onboarding:', error);
    alert('Failed to complete onboarding. Please try again.');
  }
}

async function skipOnboarding() {
  // Mark onboarding as complete even if they skip
  await completeOnboarding();
}
</script>
